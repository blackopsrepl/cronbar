#!/usr/bin/env ruby
# frozen_string_literal: true

# Print exactly one generated CHANGELOG release body; missing/empty is an error.
begin
  tag = ARGV.shift
  raise "usage: release-notes vX.Y.Z [CHANGELOG.md]" unless tag&.match?(/\Av\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?\z/)
  path = ARGV.shift || File.expand_path("../CHANGELOG.md", __dir__)
  raise "unexpected arguments" unless ARGV.empty?
  version = tag.delete_prefix("v")
  heading = /^\#{1,3} (?:\[([0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\](?:\([^\n]*\))?|([0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?))(?=\s|$)/
  found = false
  body = []
  File.foreach(path) do |line|
    match = heading.match(line)
    if match
      break if found
      found = (match[1] || match[2]) == version
    elsif found
      body << line
    end
  end
  raise "no changelog section for #{tag}" unless found
  notes = body.join.strip
  raise "empty changelog section for #{tag}" if notes.empty?
  puts notes
rescue StandardError => e
  warn "cronbar release-notes: #{e.message}"
  exit 1
end
